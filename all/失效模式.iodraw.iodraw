          <mxGeometry x="2050" y="720" width="89" height="149" as="geometry" />
        </mxCell>
        <mxCell id="fAt28AO5mf6FKWXcX9or-41" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
