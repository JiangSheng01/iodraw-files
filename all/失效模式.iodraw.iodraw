        <mxCell id="fAt28AO5mf6FKWXcX9or-28" value="P = \frac { M } { V } } E = \frac { 3 0 0&amp;nbsp; g } { 5 0&amp;nbsp; c m ^ 3 }" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
