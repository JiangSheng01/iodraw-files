        <mxCell id="fAt28AO5mf6FKWXcX9or-10" value="&lt;div style=&quot;&quot;&gt;\begin{aligned} &lt;br&gt;\text { I I I } \quad \therefore T &amp;amp; = \frac { 2 \pi } { \omega } \\ &lt;br&gt;\omega &amp;amp; = \frac { 2 \pi } { T } = \frac { 2 \pi } { \pi } = 2 &lt;br&gt;\end{aligned}&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=24;" vertex="1" parent="1">
