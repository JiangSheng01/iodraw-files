        <mxCell id="fAt28AO5mf6FKWXcX9or-26" value="\because V _ 1 = R _ 1 I _ 1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
