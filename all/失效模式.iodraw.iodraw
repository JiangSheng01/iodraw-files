        <mxCell id="fAt28AO5mf6FKWXcX9or-2" value="Models lack the ability to maintain stable global 2D structures in complex expressions." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=30;" vertex="1" parent="1">
          <mxGeometry x="-510" y="-225" width="1160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fAt28AO5mf6FKWXcX9or-3" value="Local symbol correctness does not guarantee global semantic validity." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=24;" vertex="1" parent="1">
